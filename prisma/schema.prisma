/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AdCreative {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  marketSlug              String   @map("market_slug")
  situationSlug           String   @map("situation_slug")
  platform                String   @default("meta")
  format                  String   @default("image")
  headline                String
  primaryText             String?  @map("primary_text")
  description             String?
  callToAction            String?  @default("Get Offer") @map("call_to_action")
  imagePrompt             String?  @map("image_prompt")
  imageUrl                String?  @map("image_url")
  videoConcept            Json?    @default("{}") @map("video_concept")
  sitelinkExtensions      Json?    @default("[]") @map("sitelink_extensions")
  abTestGroup             String?  @default("A") @map("ab_test_group")
  abTestHypothesis        String?  @map("ab_test_hypothesis")
  targetAudience          String?  @map("target_audience")
  estimatedRelevanceScore Decimal? @map("estimated_relevance_score") @db.Decimal
  status                  String   @default("draft")
  performanceData         Json?    @default("{}") @map("performance_data")
  sourceLeadInsights      Json?    @default("{}") @map("source_lead_insights")
  modelUsed               String?  @map("model_used")
  version                 Int      @default(1)
  brandPhotoUrl           String?  @map("brand_photo_url")

  @@map("ad_creatives")
  @@schema("public")
}

